# Runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (required for production persistence/auth/storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=flyer-images

# OCR gratuito principal: Tesseract.js roda no navegador e não exige chave.
# Fallback opcional para automações sem navegador (FastAPI + PaddleOCR):
OCR_LANGUAGE=por+eng
MIN_CONFIDENCE=0.82
REQUIRE_MANUAL_REVIEW=true
OCR_LOCAL_FALLBACK=true
PADDLEOCR_ENABLED=false
PADDLEOCR_PYTHON=python
PADDLEOCR_URL=http://127.0.0.1:8001
PADDLEOCR_TOKEN=
PADDLEOCR_TIMEOUT_MS=180000

# Optional authorized collection connector
COLLECTOR_API_URL=
COLLECTOR_API_TOKEN=

# Apify Instagram Scraper (server-only; never expose in NEXT_PUBLIC_*)
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-scraper
APIFY_TIMEOUT_MS=120
APIFY_MAX_RESULTS=30

# Optional Redis / BullMQ worker
REDIS_URL=redis://localhost:6379

# Local development auth bypass is enabled when Supabase vars are absent.
# Set this to false in environments where missing Supabase configuration must fail fast.
ALLOW_LOCAL_FALLBACK=true
